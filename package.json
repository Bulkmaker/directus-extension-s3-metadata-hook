{
  "name": "directus-extension-s3-metadata-hook",
  "version": "1.0.0",
  "description": "Sets Content-Disposition header on S3 uploads for direct download with original filename",
  "type": "module",
  "directus:extension": {
    "type": "hook",
    "path": "dist/index.js",
    "source": "src/index.ts",
    "host": "^10.0.0 || ^11.0.0"
  },
  "scripts": {
    "build": "directus-extension build",
    "dev": "directus-extension build -w --no-minify",
    "prepare": "directus-extension build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.400.0",
    "@directus/extensions-sdk": "^12.0.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "files": [
    "dist",
    "package.json",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bulkmaker/directus-extension-s3-metadata-hook.git"
  }
}
